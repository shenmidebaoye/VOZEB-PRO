# VOZEB PRO local studio environment
# Copy to web/.env.local for source development / pnpm start.

# Public origin without a trailing slash.
NEXT_PUBLIC_SITE_URL=http://127.0.0.1:3000

# Default local studio storage. Unset also becomes file under `pnpm start`.
VOZEB_PRO_DATABASE_PROVIDER=file
# Optional PostgreSQL:
# VOZEB_PRO_DATABASE_PROVIDER=postgres
# DATABASE_URL=postgres://vozeb_pro:password@localhost:5432/vozeb_pro
# VOZEB_PRO_DATABASE_POOL_MAX=10
# VOZEB_PRO_DATABASE_SSL=0
# VOZEB_PRO_DATABASE_SSL_REJECT_UNAUTHORIZED=1
# VOZEB_PRO_DATABASE_SSL_CA=

# Required for encrypting channel secrets. 64 hex chars or exact 32-byte Base64.
# Generate with `openssl rand -hex 32`, keep it stable, never commit the real value.
# Desktop mode (`pnpm desktop:dev`) auto-creates and persists this under VOZEB_PRO_DATA_DIR.
VOZEB_PRO_ENCRYPTION_KEY=

# Runtime paths and internal callbacks.
VOZEB_PRO_DATA_DIR=
VOZEB_PRO_INTERNAL_ORIGIN=http://127.0.0.1:3000
# Desktop runtime (used by `pnpm desktop:dev` / Tauri)
# VOZEB_PRO_DESKTOP=1
# VOZEB_PRO_DESKTOP_MODE=dev
# VOZEB_PRO_WEB_ROOT=
VOZEB_PRO_COOKIE_SECURE=
VOZEB_PRO_TRUSTED_PROXY_HOPS=0
FFMPEG_PATH=
FFPROBE_PATH=

# Optional outbound proxy for model/provider requests.
HTTPS_PROXY=
HTTP_PROXY=
ALL_PROXY=

# Private/loopback model providers are blocked by default.
VOZEB_PRO_ALLOW_PRIVATE_UPSTREAMS=0
VOZEB_PRO_PRIVATE_UPSTREAM_HOSTS=

# Maintenance and Worker tokens (at least 32 random characters each; must differ).
VOZEB_PRO_MAINTENANCE_TOKEN=
VOZEB_PRO_WORKER_TOKEN=
VOZEB_PRO_WORKER_API_ORIGIN=
VOZEB_PRO_GENERATION_WORKER_ID=
VOZEB_PRO_GENERATION_WORKER_INTERVAL_MS=2000
VOZEB_PRO_GENERATION_WORKER_LANES=2
VOZEB_PRO_GENERATION_WORKER_HEARTBEAT_MS=15000
VOZEB_PRO_GENERATION_WORKER_STALE_MS=90000
